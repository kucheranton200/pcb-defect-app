BACKEND_URL=http://localhost:3000/api
ML_SERVICE_URL=http://localhost:8000
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# usb | dshow | rtsp
CAMERA_MODE=usb

# USB camera on Linux. Usually /dev/video0.
USB_DEVICE=/dev/video0

# USB camera on Windows. Use `ffmpeg -list_devices true -f dshow -i dummy`
# to find the exact name.
DSHOW_DEVICE=Integrated Camera

# Industrial/IP camera stream. Example:
# RTSP_URL=rtsp://user:password@192.168.1.50:554/stream1
RTSP_URL=

FRAME_INTERVAL_SECONDS=0.5
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_DIR=frames
